FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    xPeriodic
    {
        type            cyclic;
    }
    xPeriodic_other
    {
        type            cyclic;
    }
    yPeriodic
    {
        type            cyclic;
    }
    yPeriodic_other
    {
        type            cyclic;
    }
    frontAndBack
    {
        type            noSlip;
    }
}
